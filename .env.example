# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Модель ChatGPT для отчёта (gpt-5 / gpt-5-mini / gpt-4o-mini ...)
OPENAI_MODEL=gpt-5

# === WB публичный анализ (по умолчанию любой магазин) ===
# Сколько товаров продавца брать в анализ (топ по популярности)
WB_TOP_PRODUCTS=30
# Сколько отзывов на товар забирать
WB_REVIEWS_PER_PRODUCT=30
# Регион (dest) для запросов карточек WB
WB_DEST=-1257786

# === WB API для своего магазина (PlatSer Group) ===
# Один JWT-токен из WB: Настройки → Доступ к API. При генерации отметь
# ВСЕ нужные категории доступа, чтобы один токен открыл максимум данных:
#   ✓ Статистика  → продажи, заказы, остатки   (sales / orders / stocks)
#   ✓ Контент    → карточки, фото, видео, характеристики  (content quality)
#   ✓ Аналитика  → воронка показы→корзина→заказ→выкуп     (требует Pro)
#   ✓ Тарифы     → комиссии WB и логистика по коробам    (margin)
# Если оставить пустым — авторизованные API будут отключены, бот всё
# равно работает по публичным данным (любой магазин).
WB_SUPPLIER_TOKEN=
# ID собственного магазина PlatSer на WB (число из URL wildberries.ru/seller/<ID>)
# Используется, чтобы автоматически подмешивать продажи при анализе своего магазина.
WB_OWN_SUPPLIER_ID=
# За сколько дней назад тянуть продажи/заказы по умолчанию
WB_STATS_DAYS=30

# Логи
LOG_LEVEL=INFO
