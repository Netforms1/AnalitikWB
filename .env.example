# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Модель ChatGPT (gpt-5 / gpt-5-mini / gpt-4o-mini)
OPENAI_MODEL=gpt-5

# === WB параметры по умолчанию ===
# Сколько товаров продавца брать в анализ
WB_TOP_PRODUCTS=30
# Сколько отзывов на товар забирать
WB_REVIEWS_PER_PRODUCT=30
# Регион (dest) для запросов карточек WB
WB_DEST=-1257786
# За сколько дней назад тянуть продажи/заказы по умолчанию
WB_STATS_DAYS=30

# === WB API токен по умолчанию (НЕОБЯЗАТЕЛЬНО) ===
# Если оставить пустым — бот попросит токен у пользователя в чате.
# Если заполнить — бот будет авто-подключаться к этому токену
# при /start (удобно для приватного использования).
WB_SUPPLIER_TOKEN=

# Логи
LOG_LEVEL=INFO
