# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Модель ChatGPT для генерации отчёта
OPENAI_MODEL=gpt-4o-mini

# Сколько товаров продавца брать в анализ (топ по популярности)
WB_TOP_PRODUCTS=30
# Сколько отзывов на товар забирать
WB_REVIEWS_PER_PRODUCT=30
# Регион (dest) для запросов карточек WB
WB_DEST=-1257786

# Логи
LOG_LEVEL=INFO
